<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/azul_acento"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconoDialogo"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/azul_claro"
            app:cardCornerRadius="34dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/azul_acento"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivIconoDialogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_icono" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTituloDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/azul_primario"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMensajeDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/gris_texto"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarDialogo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textColor="@color/azul_primario"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/azul_primario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptarDialogo"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/azul_primario"
                android:textColor="@color/blanco"
                android:textSize="15sp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
